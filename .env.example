# AUTEUR API Keys
# Get yours at: https://fal.ai/dashboard/keys
FAL_KEY=

# Get yours at: https://kie.ai (dashboard > API key)
KIE_API_KEY=

# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Output directory for generated assets
AUTEUR_OUTPUT_DIR=./output

# Browser automation (for web-based platforms like Grok Imagine)
BROWSER_USE_ENABLED=false
# Get yours at: https://cloud.browser-use.com/new-api-key (or use GEMINI_API_KEY)
BROWSER_USE_API_KEY=

# Optional: explicit Chrome/Chromium path
BROWSER_EXECUTABLE_PATH=
# Where to store browser auth state (cookies/localStorage)
BROWSER_STORAGE_STATE_DIR=./.browser_state
# Where to save browser run artifacts
BROWSER_ARTIFACT_DIR=./output/browser_ops

# x402 Payment Gate
# Enable to require payment proof on every MCP request
X402_ENABLED=false
# 0xAUTEUR wallet address (recipient of payments)
AUTEUR_WALLET=0xBAc0d61DE2B52Dbb7C6800210bf8A54388032109
# Minimum payment amount in wei (default: 0.0001 ETH)
SHOT_PRICE_USDC=100000000000000
# Base Sepolia RPC
BASE_SEPOLIA_RPC=https://sepolia.base.org
# 0xAUTEUR.sol contract address (for spend() settlement)
AUTEUR_CONTRACT_ADDRESS=0x4473350125F66FC17988589A9a948514866bfdE3
# Deployer private key (for signing spend() transactions)
DEPLOYER_PRIVATE_KEY=
