# AUTEUR API Keys
# Get yours at: https://fal.ai/dashboard/keys
FAL_KEY=

# Get yours at: https://kie.ai (dashboard > API key)
KIE_API_KEY=

# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Output directory for generated assets
AUTEUR_OUTPUT_DIR=./output

# Browser automation (for web-based platforms like Grok Imagine)
BROWSER_USE_ENABLED=false
# Get yours at: https://cloud.browser-use.com/new-api-key (or use GEMINI_API_KEY)
BROWSER_USE_API_KEY=
# Optional: explicit Chrome/Chromium path
BROWSER_EXECUTABLE_PATH=
# Where to store browser auth state (cookies/localStorage)
BROWSER_STORAGE_STATE_DIR=./.browser_state
# Where to save browser run artifacts
BROWSER_ARTIFACT_DIR=./output/browser_ops
